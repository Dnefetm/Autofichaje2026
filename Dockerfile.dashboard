# Imagen de producción para apps/dashboard en VPS / Coolify (sin output standalone para preservar pdf.worker.mjs y @napi-rs/canvas).
FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/dashboard/package.json ./apps/dashboard/
COPY apps/worker/package.json ./apps/worker/
COPY packages/adapters/package.json ./packages/adapters/
COPY packages/shared/package.json ./packages/shared/
COPY packages/sync/package.json ./packages/sync/

RUN npm ci

COPY apps/dashboard ./apps/dashboard
COPY packages/adapters ./packages/adapters
COPY packages/shared ./packages/shared
COPY packages/sync ./packages/sync

# NEXT_PUBLIC_* reales en tiempo de compilación (se embeben en el bundle cliente).
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_MELI_APP_ID
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_MELI_APP_ID=${NEXT_PUBLIC_MELI_APP_ID}

# Fallbacks solo para build (Docker ARG se inyecta en RUN sin persistir en ENV de runtime).
ARG SUPABASE_URL=https://build-placeholder.supabase.co
ARG SUPABASE_SERVICE_ROLE_KEY=your_build_placeholder_key

RUN npm run build -w @gestor/dashboard

ENV NODE_ENV=production
ENV PORT=3000
ENV INTERNAL_APP_URL=http://127.0.0.1:3000

EXPOSE 3000
WORKDIR /app/apps/dashboard

CMD ["sh", "-c", "npx next start -H 0.0.0.0 -p ${PORT:-3000}"]
